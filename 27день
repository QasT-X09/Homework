import 'package:flutter/material.dart';
import 'package:flutter_bloc/flutter_bloc.dart';
import '../bloc/login_bloc.dart';
import '../bloc/login_event.dart';
import '../bloc/login_state.dart';

class LoginScreen extends StatelessWidget {
  LoginScreen({super.key});

  final email = TextEditingController();
  final pass = TextEditingController();

  @override
  Widget build(BuildContext context) {
    return BlocProvider(
      create: (_) => LoginBloc(),
      child: Scaffold(
        appBar: AppBar(title: const Text("Login")),

        body: BlocListener<LoginBloc, LoginState>(
          listener: (context, state) {
            if (state is LoginError) {
              ScaffoldMessenger.of(context)
                  .showSnackBar(SnackBar(content: Text(state.message)));
            }
          },
          child: Column(
            children: [
              TextField(controller: email),
              TextField(controller: pass),

              BlocBuilder<LoginBloc, LoginState>(
                builder: (context, state) {
                  if (state is LoginLoading) {
                    return const CircularProgressIndicator();
                  }

                  return ElevatedButton(
                    onPressed: () {
                      context.read<LoginBloc>().add(
                            LoginSubmitted(email.text, pass.text),
                          );
                    },
                    child: const Text("Login"),
                  );
                },
              ),

              BlocBuilder<LoginBloc, LoginState>(
                builder: (context, state) {
                  if (state is LoginSuccess) {
                    return const Text("Success");
                  }
                  return const SizedBox();
                },
              )
            ],
          ),
        ),
      ),
    );
  }
}

////loading_screen.dart

import 'package:flutter/material.dart';

class LoadingScreen extends StatefulWidget {
  const LoadingScreen({super.key});

  @override
  State<LoadingScreen> createState() => _LoadingScreenState();
}

class _LoadingScreenState extends State<LoadingScreen> {
  String state = "idle";

  void load() async {
    setState(() => state = "loading");

    await Future.delayed(const Duration(seconds: 2));

    if (DateTime.now().second % 2 == 0) {
      setState(() => state = "success");
    } else {
      setState(() => state = "error");
    }
  }

  @override
  Widget build(BuildContext context) {
    Widget content;

    if (state == "loading") {
      content = const CircularProgressIndicator();
    } else if (state == "success") {
      content = const Text("Данные загружены");
    } else if (state == "error") {
      content = Column(
        children: [
          const Text("Ошибка"),
          ElevatedButton(onPressed: load, child: const Text("Повторить"))
        ],
      );
    } else {
      content = ElevatedButton(onPressed: load, child: const Text("Загрузить"));
    }

    return Scaffold(
      appBar: AppBar(title: const Text("Loading Example")),
      body: Center(child: content),
    );
  }
}

///BLOC login
/////login_event.dart
abstract class LoginEvent {}

class LoginSubmitted extends LoginEvent {
  final String email;
  final String password;

  LoginSubmitted(this.email, this.password);
}

////login_state.dart
abstract class LoginState {}

class LoginInitial extends LoginState {}
class LoginLoading extends LoginState {}
class LoginSuccess extends LoginState {}
class LoginError extends LoginState {
  final String message;
  LoginError(this.message);
}

////login_bloc.dart
import 'package:flutter_bloc/flutter_bloc.dart';
import 'login_event.dart';
import 'login_state.dart';

class LoginBloc extends Bloc<LoginEvent, LoginState> {
  LoginBloc() : super(LoginInitial()) {
    on<LoginSubmitted>((event, emit) async {
      if (!event.email.contains("@")) {
        emit(LoginError("Неверный email"));
        return;
      }

      if (event.password.length < 4) {
        emit(LoginError("Пароль слишком короткий"));
        return;
      }

      emit(LoginLoading());
      await Future.delayed(const Duration(seconds: 2));

      if (event.password == "1234") {
        emit(LoginSuccess());
      } else {
        emit(LoginError("Неверный пароль"));
      }
    });
  }
}

