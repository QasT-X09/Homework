import 'package:flutter_bloc/flutter_bloc.dart';

class CounterState {
  final int value;
  final List<String> history;

  CounterState(this.value, this.history);
}

class CounterCubit extends Cubit<CounterState> {
  CounterCubit() : super(CounterState(0, []));

  void increment() {
    final newHistory = [...state.history, "Increment"];
    if (newHistory.length > 10) newHistory.removeAt(0);

    emit(CounterState(state.value + 1, newHistory));
  }

  void decrement() {
    final newHistory = [...state.history, "Decrement"];
    if (newHistory.length > 10) newHistory.removeAt(0);

    emit(CounterState(state.value - 1, newHistory));
  }

  void clear() {
    emit(CounterState(0, []));
  }
}


