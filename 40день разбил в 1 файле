import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:test_project/main.dart';
import 'package:test_project/repository.dart';

void main() {
  testWidgets('Empty -> Loading -> Data', (tester) async {
    final repo = FakeRepository();

    await tester.pumpWidget(MyApp(repository: repo));

    // initial (empty)
    expect(find.byKey(const Key('emptyState')), findsOneWidget);

    // loading
    repo.setLoading();
    await tester.pump();
    expect(find.byKey(const Key('loader')), findsOneWidget);

    // data
    repo.setData(['Item 1']);
    await tester.pumpAndSettle();

    expect(find.text('Item 1'), findsOneWidget);
  });

  testWidgets('Add item', (tester) async {
    final repo = FakeRepository();

    await tester.pumpWidget(MyApp(repository: repo));
    await tester.pumpAndSettle();

    await tester.enterText(find.byKey(const Key('inputField')), 'New Item');
    await tester.tap(find.byKey(const Key('addButton')));
    await tester.pump();

    expect(find.text('New Item'), findsOneWidget);
  });

  testWidgets('Error state', (tester) async {
    final repo = FakeRepository()..setError();

    await tester.pumpWidget(MyApp(repository: repo));
    await tester.pumpAndSettle();

    expect(find.byKey(const Key('errorText')), findsOneWidget);
    expect(find.text('Ошибка загрузки'), findsOneWidget);
  });

  testWidgets('Navigation to detail screen', (tester) async {
    final repo = FakeRepository()..setData(['Item 1']);

    await tester.pumpWidget(MyApp(repository: repo));
    await tester.pumpAndSettle();

    await tester.tap(find.text('Item 1'));
    await tester.pumpAndSettle();

    expect(find.byKey(const Key('detailScreen')), findsOneWidget);
  });
}
